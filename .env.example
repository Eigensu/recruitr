# =============================================================================
# Eigensu — Root Environment Variables
# Single source of truth for both frontend and backend.
#
# HOW IT WORKS:
#   Backend  → pydantic-settings reads this file via env_file="../../.env"
#   Frontend → next.config.ts sets `env` dir to the repo root
#
# Copy this file to .env and fill in your real values.
# NEVER commit .env — it is in .gitignore.
# =============================================================================

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=Eigensu API
APP_VERSION=1.0.0
DEBUG=false

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Local dev: mongodb://localhost:27017/eigensu
# Replica-set (Docker): mongodb://localhost:27017/eigensu?replicaSet=rs0
MONGODB_URI=mongodb://localhost:27017/eigensu
MONGODB_DB_NAME=eigensu
# Startup resilience — how long each connection attempt waits for a reachable
# server, and how many attempts a worker makes before giving up and exiting.
# Raise WORKER_TIMEOUT alongside these if the total exceeds 120s.
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
# MONGODB_INIT_ATTEMPTS=3
# MONGODB_INIT_BACKOFF_SECONDS=2.0

# ── Clerk Auth ────────────────────────────────────────────────────────────────
# Get from: https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_
CLERK_SECRET_KEY=sk_test_
CLERK_JWKS_URL=https://YOUR_INSTANCE.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWT_AUDIENCE=
CLERK_WEBHOOK_SECRET=whsec_

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ── Cloudinary ────────────────────────────────────────────────────────────────
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=eigensu_resumes
CLOUDINARY_WEBHOOK_SECRET=

# Public vars consumed by the Next.js frontend
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=eigensu_resumes

# ── Frontend → Backend API ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── CORS (backend) ───────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ── Inbound lead intake (Meta lead ads → Google Sheet) ───────────────────────
# Setup, once:
#   1. Create a GCP service account and download its JSON key.
#   2. Enable the Google Sheets API for that project.
#   3. Share the spreadsheet with the service account's client_email as Viewer.
#      Without this share every read returns 403 and no lead is ever ingested.
# The key is multi-line JSON containing a PEM block, which some platforms cannot
# store intact — base64 of the same file is accepted.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Off until the above is done; the poll task returns immediately while false.
GOOGLE_SHEETS_ENABLED=false
INTAKE_SPREADSHEET_ID=
INTAKE_SHEET_RANGE=Sheet1!A:U
INTAKE_POLL_MINUTES=10
# Optional: {"sheet header": "candidate_field"} to retarget a renamed column.
INTAKE_SHEET_COLUMN_OVERRIDES=
# Hours before an unactioned lead is reported overdue to an admin.
TELECALLER_SLA_HOURS=24
RECRUITER_SLA_HOURS=24
