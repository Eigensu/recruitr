# =============================================================================
# Eigensu — UAT environment variables
#
# These are NOT loaded from a file at runtime. UAT is deployed from managed
# platforms, so each value below is set in a dashboard:
#
#   Backend  → Railway, project "Eigensu Recruitment", environment `uat`
#   Frontend → Vercel, project `recruitr-uat`
#
# This file is the checked-in record of what those two places should contain.
# See docs/UAT_SETUP.md for the full provisioning walkthrough.
#
# UAT lives on a different apex domain than production (recruitr.in vs
# eigensu.in), so nothing here can be copied from prod verbatim.
# =============================================================================

# ── Backend: Railway `uat` environment ───────────────────────────────────────

APP_NAME=Eigensu API (UAT)
APP_VERSION=1.0.0

# Must stay false. app/main.py derives `_COOKIE_SECURE = not settings.DEBUG`,
# so DEBUG=true strips `Secure` off the session cookie over HTTPS.
DEBUG=false

# Dedicated UAT Atlas cluster — never the production connection string.
MONGODB_URI=mongodb+srv://<user>:<password>@<uat-cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=recruitr_uat

# Parsed by pydantic as list[str], so it must be a JSON array, not a bare string.
CORS_ORIGINS=["https://uat.recruitr.in"]

FRONTEND_URL=https://uat.recruitr.in

# The HttpOnly access_token cookie is issued by the API and read by Next.js
# middleware, so both hosts must sit under this parent domain. This is why the
# UAT API is api.uat.recruitr.in and not something under *.eigensu.in.
COOKIE_DOMAIN=.recruitr.in

# Generate fresh values — `openssl rand -hex 32`. Reusing production's secret
# would let a production token authenticate against UAT and vice versa.
JWT_SECRET=
SESSION_SECRET=   # falls back to JWT_SECRET when blank

# Comma-separated domains allowed to hold a staff account. An empty value
# blocks every new signup, which on a fresh UAT database means nobody can get
# in at all — set it to the same list production uses.
AGENCY_EMAIL_DOMAINS=

# Add this exact URI to the Google OAuth client's authorized redirect URIs, and
# https://uat.recruitr.in to its authorized JavaScript origins.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.uat.recruitr.in/api/v1/auth/google/callback

# Point at the `redis` service inside the SAME Railway environment. Railway
# resolves this reference per-environment, so it cannot leak into prod's Redis.
REDIS_ENABLED=true
REDIS_URL=${{Redis.REDIS_URL}}
CELERY_BROKER_URL=${{Redis.REDIS_URL}}
CELERY_RESULT_BACKEND=${{Redis.REDIS_URL}}

# Safe to share with production — uploads are content-addressed, not tenant
# scoped. Use a separate upload preset if you want UAT assets segregated.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=eigensu_resumes

RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@uat.recruitr.in


# ── Frontend: Vercel project `recruitr-uat` (Production scope) ───────────────
#
# NEXT_PUBLIC_API_URL is read in ~10 modules (src/lib/api/*, src/hooks/
# useCurrentUser.ts, the kanban boards) and every one of them falls back to
# http://localhost:8000 when it is unset. A missing value therefore fails
# silently in the browser rather than at build time — set it.

NEXT_PUBLIC_API_URL=https://api.uat.recruitr.in
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=eigensu_resumes
