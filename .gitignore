# =============================================================================
# Eigensu — Root .gitignore
# =============================================================================

# ── Environment (NEVER commit secrets) ───────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example
!.env.uat.example

# ── Node ─────────────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/
.turbo/

# ── Vercel ───────────────────────────────────────────────────────────────────
# Written by `vercel pull` / `vercel build`, including a plaintext .env of the
# project's environment variables.
.vercel/

# ── Next.js ──────────────────────────────────────────────────────────────────
apps/frontend/.next/
apps/frontend/tsconfig.tsbuildinfo
apps/frontend/out/
apps/frontend/test-results/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDEs ─────────────────────────────────────────────────────────────────────
.idea/
*.swp
*.swo

# ── Docker ───────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ── Data & Backups ───────────────────────────────────────────────────────────
specs/data/Database CV_s FY26-27/
specs/data/pdfs/
apps/backend/backup_*/
brand-delete-backup-*.json
